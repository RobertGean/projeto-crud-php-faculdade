# Use este arquivo SOMENTE quando não for possível apontar o DocumentRoot para public/
# (ex.: hospedagem compartilhada em que o projeto fica dentro de public_html).
# Ele redireciona tudo para public/, deixando app/, config/, .env etc. inacessíveis.

Options -Indexes

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
