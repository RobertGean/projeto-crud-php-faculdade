# Copie este arquivo para .env e preencha com os dados do seu projeto no Neon.
# NUNCA envie o .env para o GitHub (ele já está no .gitignore).

# Connection string do Neon (use o host com "-pooler")
SRVDB="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# true apenas em desenvolvimento: mostra detalhes técnicos dos erros na tela
APP_DEBUG=false

APP_URL=http://localhost:8000

# true => links no formato /clientes/editar/5 (precisa de mod_rewrite ou php -S)
# false => links no formato index.php?rota=clientes/editar&id=5 (funciona em qualquer servidor)
APP_URL_AMIGAVEL=false
